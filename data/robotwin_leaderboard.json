    "rankings": [
      {
        "id": "avg",
        "label": "Average（c2c+c2r）",
        "value": "(easy_mean + hard_mean) / 2",
        "eval": "(c2c + c2r) / 2"
      },
      {
        "id": "hard",
        "label": "clean2random（hard）",
        "value": "hard_mean",
        "eval": "demo_randomized"
      },
      {
        "id": "easy",
        "label": "clean2clean（easy）",
        "value": "easy_mean",
        "eval": "demo_clean"
      }
    ],
    "settings": [
      {
        "id": "cotrain",
        "label": "Co-train",
        "description": "one policy jointly trained on all 50 tasks"
      },
      {
        "id": "sft",
        "label": "Single",
        "description": "one checkpoint fine-tuned per task"
      }
    ],
    "entry_fields": {
      "id": "stable entry id, '<setting>:<slug>'",
      "name": "display name of the method",
      "setting": "cotrain | sft",
      "contributor": "team that produced the numbers",
      "listed_at": "date added to the board, YY.MM.DD",
      "easy_mean": "mean success rate (%) under demo_clean",
      "hard_mean": "mean success rate (%) under demo_randomized",
      "easy": "per-task success rate (%) under demo_clean, aligned with tasks[]",
      "hard": "per-task success rate (%) under demo_randomized, aligned with tasks[]"
